[configuration]
entry_symbol = "sabrina_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libsabrina.so"
linux.release.x86_64 = "res://bin/libsabrina.so"
windows.debug.x86_64 = "res://bin/sabrina.dll"
windows.release.x86_64 = "res://bin/sabrina.dll"
macos.debug = "res://bin/libsabrina.dylib"
macos.release = "res://bin/libsabrina.dylib"
